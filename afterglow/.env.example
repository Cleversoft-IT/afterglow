# =============================================================================
# Afterglow — environment configuration
# Copy to .env and fill with your credentials.
# =============================================================================

# --- Backend / API ----------------------------------------------------------
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=20
DEMO_MODE=false                 # if true, skip Speechmatics and use cached transcripts

# --- Database (Vultr Managed Postgres) --------------------------------------
# Default targets the docker-compose service name `postgres`. For host-side
# dev (podman run on Fedora, brew postgres on macOS) override to 127.0.0.1:
#   DATABASE_URL=postgresql+asyncpg://afterglow:afterglow@127.0.0.1:5432/afterglow
DATABASE_URL=postgresql+asyncpg://afterglow:afterglow@postgres:5432/afterglow

# --- Google Gemini ----------------------------------------------------------
GOOGLE_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-flash-latest
GEMINI_TEMPLATE_BUILDER_MODEL=gemini-3-flash-preview

# --- Vultr Serverless Inference --------------------------------------------
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=MiniMaxAI/MiniMax-M2.7

# --- Vultr Vector Store -----------------------------------------------------
# Required in production. If empty, the orchestrator skips RAG retrieval and
# vector write-back (Postgres briefing still works).
VULTR_VECTOR_DEFAULT_COLLECTION=

# --- Speechmatics -----------------------------------------------------------
SPEECHMATICS_API_KEY=
SPEECHMATICS_BATCH_URL=https://asr.api.speechmatics.com/v2

# --- Storage local audio ----------------------------------------------------
# Default is the path mounted as a volume in docker-compose / Coolify.
# For host-side dev (no container) override to a writable path:
#   AUDIO_STORAGE_DIR=./var/audio
AUDIO_STORAGE_DIR=/var/data/audio

# --- CORS allowed origins (CSV) ---------------------------------------------
# Comma-separated list. In production set to the deployed app + demo-site URLs,
# e.g. https://app.95-179-245-107.sslip.io,https://demo.95-179-245-107.sslip.io
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# --- App (Expo) -------------------------------------------------------------
EXPO_PUBLIC_API_BASE=http://localhost:8000

# --- Demo site (Vite) -------------------------------------------------------
VITE_APP_URL=http://localhost:8081
